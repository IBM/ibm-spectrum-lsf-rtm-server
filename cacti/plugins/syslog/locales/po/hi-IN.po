msgstr "Syslog स्थापना रद्द गर्ने प्राथमिकताहरू"

#: setup.php:1020
msgid "Uninstall"
msgstr "अनइंस्टाल करो"

#: setup.php:1027 syslog_alerts.php:208 syslog_removal.php:230
#: syslog_reports.php:208
