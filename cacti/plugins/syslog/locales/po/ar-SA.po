msgid "Database Architecture"
msgstr "بنية قاعدة البيانات"

#: setup.php:884
msgid "You have the option to make this a partitioned table by days.  You can create multiple partitions per day."
msgstr "لديك خيار جعل هذا الجدول مقسما حسب الأيام.  يمكنك إنشاء أقسام متعددة يوميا."

#: setup.php:887
msgid "Traditional Table"
msgstr "طاولة تقليدية"

#: setup.php:888
msgid "Partitioned Table"
msgstr "جدول مقسم"

#: setup.php:893
msgid "Retention Policy"
msgstr "سياسة الاحتفاظ"

#: setup.php:894
